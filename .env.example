# Environment Configuration

# User Identity & Personalization
USER_NAME=TuNombre

# LLM API Keys (Groq, Gemini, DeepInfra)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Integrations
LINKEDIN_ACCESS_TOKEN=your_linkedin_token_here
TIKTOK_USERNAME=your_tiktok_username_here
TIKTOK_PASSWORD=your_tiktok_password_here
OUTLOOK_CLIENT_ID=your_outlook_id_here
OUTLOOK_CLIENT_SECRET=your_outlook_secret_here
SLACK_BOT_TOKEN=your_slack_token_here
CLICKUP_API_KEY=your_clickup_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here

# Server & Storage
PORT=5000
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379
